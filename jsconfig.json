{
  "compilerOptions": {
    "checkJs": true,
    "strict": false,
    "noImplicitAny": false,

    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "module": "es2022",
    "target": "es2022",
    "moduleResolution": "node"
  },
  "include": ["./**/*"]
}
